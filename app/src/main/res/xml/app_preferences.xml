<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory android:title="@string/settings_category_language" app:allowDividerAbove="false">
        <ListPreference android:icon="@drawable/outline_language_24" android:title="@string/settings_language" android:key="language" android:summary="%s" android:defaultValue="SYSTEM" android:entries="@array/language_entries" android:entryValues="@array/language_values" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/settings_category_appearance" app:allowDividerAbove="false">
        <ListPreference android:icon="@drawable/outline_dark_mode_24" android:entries="@array/night_mode" android:title="@string/settings_dark_theme" android:key="night_mode" android:summary="%s" android:entryValues="@array/night_mode_value" />
        <ListPreference android:icon="@drawable/palette_24px" android:entries="@array/theme_mode" android:title="@string/settings_theme_mode" android:key="theme_mode" android:summary="%s" android:defaultValue="classic_purple" android:entryValues="@array/theme_mode_value" />
    </PreferenceCategory>
</PreferenceScreen>
