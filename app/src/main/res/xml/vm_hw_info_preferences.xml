        <com.android.vmapp.ui.base.preference.EditTextPreferenceEX app:dialogLayout="@layout/preference_dialog_edittext_ex" app:iconSpaceReserved="false" app:key="vm_pref_key_product_model" app:title="@string/vm_hw_product_model" app:useSimpleSummaryProvider="true" />
