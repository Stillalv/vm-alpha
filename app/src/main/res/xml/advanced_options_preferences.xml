<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory app:allowDividerAbove="false" app:iconSpaceReserved="false" app:title="@string/floating_window_settings_title">
        <SwitchPreferenceCompat app:iconSpaceReserved="false" app:key="pref_key_small_window" app:summaryOff="@string/switch_off" app:summaryOn="@string/switch_on" app:title="@string/pref_title_small_window" />
        <SwitchPreferenceCompat app:iconSpaceReserved="false" app:key="pref_key_small_window_state" app:summaryOff="@string/switch_off" app:summaryOn="@string/switch_on" app:title="@string/pref_title_small_window_state" />
        <SwitchPreferenceCompat app:iconSpaceReserved="false" app:key="pref_key_mini_ball" app:summaryOff="@string/switch_off" app:summaryOn="@string/switch_on" app:title="@string/pref_title_mini_ball" />
    </PreferenceCategory>
    <PreferenceCategory app:allowDividerAbove="false" app:iconSpaceReserved="false" app:title="@string/boot_options_settings_title">
        <SwitchPreferenceCompat app:iconSpaceReserved="false" app:key="pref_key_boot_in_bg" app:summaryOff="@string/switch_off" app:summaryOn="@string/switch_on" app:title="@string/pref_title_boot_in_bg" />
        <SwitchPreferenceCompat app:iconSpaceReserved="false" app:key="pref_key_show_boot_animation" app:summaryOff="@string/switch_off" app:summaryOn="@string/switch_on" app:title="@string/pref_title_show_boot_animation" />
    </PreferenceCategory>
</PreferenceScreen>
