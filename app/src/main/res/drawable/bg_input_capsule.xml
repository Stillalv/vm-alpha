<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#fff1f5f9" />
            <corners android:radius="12.0dip" />
            <stroke android:width="1.0dip" android:color="#ffe2e8f0" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#ffffffff" />
            <corners android:radius="12.0dip" />
            <stroke android:width="1.5dip" android:color="#ff10b981" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#ffffffff" />
            <corners android:radius="12.0dip" />
            <stroke android:width="1.0dip" android:color="#ffcbd5e1" />
        </shape>
    </item>
</selector>
