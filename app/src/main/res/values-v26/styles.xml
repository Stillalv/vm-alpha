<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppAuthUI.TextInputEditText.EmailField" parent="@style/AppAuthUI.TextInputEditText">
        <item name="android:inputType">textEmailAddress</item>
        <item name="android:autofillHints">emailAddress</item>
    </style>

    <style name="AppAuthUI.TextInputEditText.NameField" parent="@style/AppAuthUI.TextInputEditText">
        <item name="android:inputType">textCapWords</item>
        <item name="android:autofillHints">name</item>
    </style>

    <style name="AppAuthUI.TextInputEditText.PasswordField" parent="@style/AppAuthUI.TextInputEditText">
        <item name="android:inputType">textPassword</item>
        <item name="android:autofillHints">password</item>
    </style>

    <style name="AppAuthUI.TextInputEditText.PhoneField" parent="@style/AppAuthUI.TextInputEditText">
        <item name="android:inputType">phone</item>
        <item name="android:autofillHints">phone</item>
    </style>
</resources>
